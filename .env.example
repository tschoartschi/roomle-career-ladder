# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# In CI, these come from GitHub Secrets (sensitive) and Repository Variables (non-sensitive).

# --- Non-sensitive (GitHub Repository Variables in CI) ---

# Confluence Cloud domain — BARE, no /wiki suffix.
# Example: https://roomle.atlassian.net  (NOT https://roomle.atlassian.net/wiki)
CONFLUENCE_BASE_URL=

# Numeric ID of the parent page that all published pages should live under.
# Find it in the URL when viewing the parent page in Confluence.
CONFLUENCE_PARENT_ID=

# Confluence space key (e.g. "careerladder").
CONFLUENCE_SPACE_KEY=

# Numeric ID of the dedicated "Archive" page (sibling under root parent).
# Orphaned pages are moved here instead of deleted.
CONFLUENCE_ARCHIVE_PARENT_ID=

# --- Sensitive (GitHub Repository Secrets in CI) ---

# The Atlassian account email used to authenticate.
ATLASSIAN_USER_NAME=

# Atlassian API token — create at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=
